# Optional browser accounts. Copy to .env.local and supply your public values.
# Guest play works without these. Never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Development and production still serve the custom-domain root.
