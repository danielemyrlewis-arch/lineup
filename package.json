{
  "name": "lineup",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/check-static-export.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "download:oscar-evidence": "node --experimental-strip-types scripts/download-oscar-evidence.ts",
    "compile:oscar-evidence": "node --experimental-strip-types scripts/compile-oscar-evidence.ts",
    "prepare:oscar-coverage": "node --experimental-strip-types scripts/prepare-oscar-coverage.ts",
    "prepare:oscars": "node --experimental-strip-types scripts/import-oscars.ts",
    "simulate:oscars": "node --experimental-strip-types scripts/simulate-oscars.ts",
    "simulate:practice": "node --experimental-strip-types scripts/simulate-practice.ts",
    "audit:public": "node scripts/audit-public-source.mjs",
    "generate:daily": "node --experimental-strip-types scripts/generate-daily.ts",
    "check:daily": "node --experimental-strip-types scripts/generate-daily.ts --check",
    "prebuild": "npm run check:daily"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
